#. Plugin Name of the plugin
#: shiplume.php
msgid "Shiplume - Free Shipping Bar for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: shiplume.php
msgid "https://plogins.com/plogins-nudge/"
msgstr ""

#. Description of the plugin
#: shiplume.php
msgid ""
"Show a free-shipping progress bar that nudges shoppers to add more to their "
"cart."
msgstr ""
"Zeige einen Fortschrittsbalken für den kostenlosen Versand an, der Käufer "
"dazu anregt, mehr in ihren Warenkorb zu legen."

#. Author of the plugin
#: shiplume.php
msgid "WPPoland.com"
msgstr ""

#. Author URI of the plugin
#: shiplume.php
msgid "https://wppoland.com"
msgstr ""

#: shiplume.php:48
msgid ""
"Shiplume - Free Shipping Bar for WooCommerce requires WooCommerce to be "
"active."
msgstr ""

#: src/Admin/ProUpsell.php:78
msgid "Wkrótce"
msgstr "Demnächst"

#: src/Admin/ProUpsell.php:78
msgid "Coming soon"
msgstr "Demnächst"

