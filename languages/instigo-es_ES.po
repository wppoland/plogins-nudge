msgid "Instigo - Free Shipping Bar for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: instigo.php
msgid "https://plogins.com/plogins-nudge/"
msgstr ""

#. Description of the plugin
#: instigo.php
msgid ""
"Show a free-shipping progress bar that nudges shoppers to add more to their "
"cart."
msgstr ""
"Muestre una barra de progreso de envío gratuito que impulse a los "
"compradores a añadir más a su carrito."

#. Author of the plugin
#: instigo.php
msgid "WPPoland.com"
msgstr ""

#. Author URI of the plugin
#: instigo.php
msgid "https://wppoland.com"
msgstr ""

#: instigo.php:48
msgid ""
"Instigo - Free Shipping Bar for WooCommerce requires WooCommerce to be "
"active."
msgstr ""

